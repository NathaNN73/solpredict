# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/

# Test / type caches
.pytest_cache/
.mypy_cache/

# Runtime data: only the raw rates source (rates.csv) is version-controlled
# so historical observations survive redeploys. forecast.json and alerts.json
# are derived artifacts, regenerable on demand, and stay out of git.
data/forecast.json
data/alerts.json
!data/.gitkeep

# Tests (solo project)
tests/

# SDD / tool artifacts
openspec/
.atl/

# Environment
.venv/
.env